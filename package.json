{
  "name": "pwa-gram",
  "version": "1.0.0",
  "description": "A simple Instagram clone built using Progressive Web App techniques.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "pwa",
    "progressive",
    "web",
    "app"
  ],
